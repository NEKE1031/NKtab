{
  "manifest_version": 3,
  "name": "NKtab",
  "version": "1.9.0",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://weather.service.msn.com/*",
    "https://api.msn.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
